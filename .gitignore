# Live secrets are created under /home/user/hermes/keys and
# /home/user/hermes/ollama-stack/.env. They are not seeds.
# config/hermes.env, config/config.yaml, and .env.example stay tracked.
# openclaw/openclaw.json.template stays tracked. A filled openclaw.json does not.

# Credentials and key material
.env
.env.*
!.env.example
keys/
secrets/
*.key
*.pem
*.p12
*.pfx
*.ppk
*.password
*.passwd
*.token
*.secret
*.age
*.kdbx
id_*
*_ed25519
*_ed25519.pub
*.pub
authorized_keys
known_hosts
known_hosts.old
.netrc
credentials.json
auth.json
service-account*.json
openclaw.json
**/cron/jobs.json

