#!/usr/bin/env python3
"""Send one sdptool or l2ping command to the host-namespace daemon."""
import json
import socket
import struct
import sys

SOCK_PATH = "/run/bleep-hostnet.sock"


def recvall(sock, size):
    buf = b""
    while len(buf) < size:
        part = sock.recv(size - len(buf))
        if not part:
            raise SystemExit(1)
        buf += part
    return buf


def main():
    if len(sys.argv) < 2:
        raise SystemExit(2)
    payload = json.dumps({"tool": sys.argv[1], "args": sys.argv[2:]}).encode()
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(SOCK_PATH)
    sock.sendall(struct.pack("!I", len(payload)) + payload)
    while True:
        kind, length = struct.unpack("!BI", recvall(sock, 5))
        data = recvall(sock, length) if length else b""
        if kind == 1:
            sys.stdout.buffer.write(data)
            sys.stdout.buffer.flush()
        elif kind == 2:
            sys.stderr.buffer.write(data)
            sys.stderr.buffer.flush()
        elif kind == 3:
            raise SystemExit(data[0] if data else 1)


if __name__ == "__main__":
    main()
